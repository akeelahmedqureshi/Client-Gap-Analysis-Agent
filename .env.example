# ---- Deployment (used by docker-compose.yml) ------------------------------
# Public URL users open in the browser (CORS + OAuth redirects).
CIP_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=change-me-strong-db-password
# Host binding for the web container: 127.0.0.1:8080 (behind an HTTPS proxy) or 8080 (all interfaces).
WEB_BIND=127.0.0.1:8080

# ---- Core --------------------------------------------------------------
# Set to "production" on servers: requires real secrets and skips auto table creation (Alembic runs instead).
CIP_ENVIRONMENT=development
# CIP_DATABASE_URL=postgresql+asyncpg://cip:cip@localhost:5432/cip   # default: local SQLite
CIP_JWT_SECRET=replace-with-a-long-random-string-of-32+-chars
# Fernet key for encrypting GitHub/GitLab tokens at rest (required in production):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CIP_TOKEN_ENCRYPTION_KEY=
CIP_ALLOW_REGISTRATION=true          # set false after creating the first admin
CIP_RESUME_RUNS_ON_STARTUP=true       # restart analyses interrupted by a restart/deploy

# ---- Where analyses run ------------------------------------------------
# inline = inside the API process (single API process, no extra services)
# celery = Celery workers via Redis (scale API + workers; docker-compose uses this)
CIP_RUN_EXECUTOR=inline
# CIP_REDIS_URL=redis://localhost:6379/0  # required for celery; also shares login rate limits
# CIP_API_WORKERS=1                       # API processes in Docker (>1 only with celery)

# ---- Login protection ---------------------------------------------------
CIP_LOGIN_MAX_FAILURES=5
CIP_LOGIN_LOCKOUT_MINUTES=15
CIP_LOGIN_IP_LIMIT=20
CIP_LOGIN_IP_WINDOW_SECONDS=300

# ---- LLM via OpenRouter -------------------------------------------------
CIP_OPENROUTER_API_KEY=
# Verify the exact slug on https://openrouter.ai/models and adjust if needed.
CIP_OPENROUTER_MODEL=openai/gpt-6-luna
CIP_LLM_TEMPERATURE=0.2

# ---- JavaScript rendering of websites (needs the [browser] extra + Chromium) ----
# auto = only pages that look script-rendered; always = every page; never = plain HTTP only
CIP_BROWSER_RENDERING=auto
# CIP_BROWSER_EXECUTABLE=/path/to/chromium   # default: Playwright's installed Chromium

# ---- Web search (competitor discovery): tavily | brave | none -------------
CIP_SEARCH_PROVIDER=none
CIP_TAVILY_API_KEY=
CIP_BRAVE_API_KEY=

# ---- GitHub / GitLab OAuth apps (optional; PATs can be added in Settings) --
CIP_GITHUB_CLIENT_ID=
CIP_GITHUB_CLIENT_SECRET=
CIP_GITLAB_CLIENT_ID=
CIP_GITLAB_CLIENT_SECRET=
CIP_GITLAB_URL=https://gitlab.com
CIP_OAUTH_REDIRECT_BASE=http://localhost:8000
